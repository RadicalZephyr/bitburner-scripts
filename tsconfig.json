{
    "include": [
        "NetscriptDefinitions.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js"
    ],
    "exclude": [
        "src/lib/react.ts",
        "src/jest-shim.ts",
        "src/**/*.test.ts",
        "src/test_util/**/*.ts"
    ],
    "compilerOptions": {
        "lib": ["esnext", "dom"],
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "strict": true,
        "skipLibCheck": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noUncheckedSideEffectImports": true,
        "esModuleInterop": true,
        "inlineSourceMap": false,
        "inlineSources": false,
        "rootDir": "src/",
        "outDir": "dist/",
        "baseUrl": "src/",
        "allowJs": true,
        "types": ["jest"],
        "paths": {
            "@ns": ["../NetScriptDefinitions.d.ts"]
        }
    },
    "watchOptions": {
        "excludeDirectories": ["node_modules", "dist/**"],
        "excludeFiles": ["src/lib/sodium**", "src/lib/typescript-collections**"]
    }
}
